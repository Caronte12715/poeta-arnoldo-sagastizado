---
import Layout from '../layouts/Layout.astro';
import LibrosInteractivos from '../components/LibrosInteractivos.vue';
import GaleriaPoemas from '../components/GaleriaPoemas.vue';
import Reconocimientos from '../components/Reconocimientos.astro';
---

<Layout title="Arnoldo Sagastizado | Poeta Salvadoreño">

  <section class="relative min-h-screen flex items-center justify-center overflow-hidden bg-slate-950">
    <img
      src="/poeta.jpg"
      alt="Fotografía del poeta Arnoldo Sagastizado"
      class="absolute inset-0 w-full h-full object-cover opacity-50 filter grayscale hover:grayscale-0 transition-all duration-1000"
    />

    <div class="absolute inset-0 bg-gradient-to-t from-slate-950 via-slate-950/80 to-slate-950/40"></div>
    <div class="absolute inset-0 bg-[url('data:image/svg+xml;base64,PHN2ZyB3aWR0aD0iNDAiIGhlaWdodD0iNDAiIHhtbG5zPSJodHRwOi8vd3d3LnczLm9yZy8yMDAwL3N2ZyI+PHBhdGggZD0iTTAgMGg0MHY0MEgwVjB6bTIwIDIwaDIwdjIwSDIwdi0yMHptLTIwIDBoMjB2MjBIMHYtMjB6IiBmaWxsPSIjZmZmIiBmaWxsLW9wYWNpdHk9IjAuMDIiIGZpbGwtcnVsZT0iZXZlbm9kZCIvPjwvc3ZnPg==')] opacity-20"></div>

    <div class="relative z-10 max-w-5xl mx-auto px-6 flex flex-col items-center text-center mt-20">
      <div class="inline-flex items-center gap-2 px-4 py-2 rounded-full border border-yellow-500/30 bg-yellow-500/10 text-yellow-400 text-sm font-medium tracking-widest uppercase mb-8 backdrop-blur-md shadow-lg">
        <span class="w-2 h-2 rounded-full bg-yellow-400 animate-pulse"></span>
        Doctor Honoris Causa
      </div>

      <h1 class="font-['Playfair_Display'] text-6xl md:text-8xl font-bold text-white mb-6 tracking-tight drop-shadow-lg">
        Arnoldo <span class="text-transparent bg-clip-text bg-gradient-to-r from-yellow-200 to-yellow-500 text-glow">Sagastizado</span>
      </h1>

      <p class="text-xl md:text-2xl text-slate-300 max-w-2xl font-light mb-12 leading-relaxed drop-shadow-md">
        Una voz inquebrantable de la poesía salvadoreña. Descubre la obra, vida y legado de un maestro de las letras.
      </p>

      <div class="flex flex-col sm:flex-row gap-6">
        <a href="#biografia" class="group relative px-8 py-4 bg-yellow-500 text-slate-950 rounded-full font-bold overflow-hidden transition-all hover:scale-105 hover:shadow-[0_0_40px_rgba(234,179,8,0.4)] shadow-lg shadow-yellow-900/50">
          <span class="relative z-10">Conocer su Historia</span>
          <div class="absolute inset-0 h-full w-full bg-gradient-to-r from-yellow-400 to-yellow-600 opacity-0 group-hover:opacity-100 transition-opacity"></div>
        </a>
        <a href="#obras" class="px-8 py-4 bg-white/5 border border-white/10 text-white rounded-full font-medium backdrop-blur-md hover:bg-white/10 hover:border-white/20 transition-all shadow-lg">
          Explorar Obras
        </a>
      </div>
    </div>
  </section>

  <section id="biografia" class="py-24 bg-slate-900 relative">
    <div class="max-w-4xl mx-auto px-6 text-center">
      <span class="text-yellow-500 font-medium tracking-[0.2em] uppercase text-sm mb-2 block">Biografía</span>
      <h2 class="font-['Playfair_Display'] text-3xl md:text-4xl font-bold text-white mb-6">
        El Legado de un Maestro
      </h2>
      <div class="w-20 h-1 bg-yellow-500 mx-auto mb-10"></div>

      <p class="text-slate-300 text-lg leading-relaxed mb-6 font-light">
        Arnoldo Sagastizado no es solo un nombre en la literatura, es un pilar fundamental de nuestra cultura. Su reciente investidura como Doctor Honoris Causa refleja una vida entera dedicada a la excelencia literaria y académica, elevando el nombre de El Salvador a través de su pluma.
      </p>
      <p class="text-slate-300 text-lg leading-relaxed font-light">
        A través de sus versos, ha capturado la esencia, las luchas y la inmensa belleza de su entorno, dejando una huella imborrable que continuará inspirando a las futuras generaciones de escritores.
      </p>
    </div>
  </section>

  <LibrosInteractivos client:visible />

  <section id="obras" class="bg-slate-950 border-t border-slate-900 relative z-20 shadow-[0_-20px_60px_rgba(0,0,0,0.8)]">
    <GaleriaPoemas client:visible />
  </section>

  <Reconocimientos />

</Layout>

<style>
  .text-glow {
    text-shadow: 0 0 30px rgba(234, 179, 8, 0.5);
  }
</style>

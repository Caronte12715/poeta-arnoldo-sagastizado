---
const premios = [
  {
    año: "2023",
    titulo: "Doctor Honoris Causa",
    institucion: "Universidad Nacional",
    descripcion: "Máximo galardón otorgado por su invaluable aporte a la literatura salvadoreña y su trayectoria intachable como poeta y humanista."
  },
  {
    año: "2015",
    titulo: "Premio Nacional de Literatura",
    institucion: "Ministerio de Cultura",
    descripcion: "Reconocimiento a su poemario 'Ecos del Volcán', destacando su capacidad para capturar la identidad nacional."
  },
  {
    año: "2008",
    titulo: "Hijo Meritísimo",
    institucion: "Asamblea Legislativa de El Salvador",
    descripcion: "Nombrado por su destacada labor en la promoción de las artes y la educación en las nuevas generaciones."
  }
];
---

<section id="reconocimientos" class="py-24 relative overflow-hidden">
  <div class="absolute top-0 left-1/2 -translate-x-1/2 w-[800px] h-[400px] bg-yellow-500/10 rounded-full blur-[120px] pointer-events-none"></div>

  <div class="max-w-4xl mx-auto px-6 relative z-10">
    <div class="text-center mb-16">
      <span class="text-yellow-500 font-medium tracking-[0.2em] uppercase text-sm mb-2 block">Trayectoria</span>
      <h2 class="font-['Playfair_Display'] text-4xl md:text-5xl font-bold text-white mb-6">
        Reconocimientos
      </h2>
      <div class="w-16 h-1 bg-yellow-500 mx-auto rounded-full"></div>
    </div>

    <div class="relative border-l-2 border-slate-800 ml-4 md:ml-0 md:border-l-0">

      <div class="hidden md:block absolute left-1/2 -translate-x-1/2 top-0 bottom-0 w-[2px] bg-slate-800"></div>

      <div class="space-y-12">
        {premios.map((premio, index) => (
          <div class={`relative flex flex-col md:flex-row items-center ${index % 2 === 0 ? 'md:flex-row-reverse' : ''}`}>

            <div class="absolute left-[-9px] md:left-1/2 md:-translate-x-1/2 w-4 h-4 rounded-full bg-slate-950 border-2 border-yellow-500 shadow-[0_0_15px_rgba(234,179,8,0.6)] z-10"></div>

            <div class="hidden md:block w-1/2"></div>

            <div class={`ml-8 md:ml-0 md:w-1/2 flex w-full ${index % 2 === 0 ? 'md:justify-end md:pr-12' : 'md:justify-start md:pl-12'}`}>

              <div class="w-full p-6 rounded-2xl backdrop-blur-md transition-all duration-500 hover:-translate-y-1 bg-slate-900/40 border border-slate-800 hover:border-yellow-500/50 hover:bg-yellow-900/10 hover:shadow-[0_0_30px_rgba(234,179,8,0.15)] group">

                <span class="text-yellow-500 font-bold text-lg mb-1 block font-['Playfair_Display'] transition-transform duration-300 group-hover:scale-105 origin-left">{premio.año}</span>
                <h3 class="text-2xl text-white font-semibold mb-2 group-hover:text-yellow-400 transition-colors">{premio.titulo}</h3>
                <span class="text-slate-400 text-sm uppercase tracking-wider block mb-4">{premio.institucion}</span>
                <p class="text-slate-300 font-light leading-relaxed">
                  {premio.descripcion}
                </p>
              </div>

            </div>

          </div>
        ))}
      </div>
    </div>
  </div>
</section>
